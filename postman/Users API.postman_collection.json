    {
      "name": "12 Update user",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/task-management/users/:id",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "task-management",
            "users",
            ":id"
          ],
          "variable": [
            {
              "key": "id",
              "value": "{{user_id}}"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Nguyen Van A (updated)\",\n  \"password\": \"NewPassword456!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('fullName updated', () => pm.expect(body.fullName).to.eql('Nguyen Van A (updated)'));",
              "pm.test('email unchanged', () => pm.expect(body.email).to.eql(pm.collectionVariables.get('user_email')));",
              "pm.test('updatedAt >= createdAt', () => {",
              "  pm.expect(new Date(body.updatedAt).getTime()).to.be.at.least(new Date(body.createdAt).getTime());",
              "});",
              "pm.test('Does not expose passwordHash', () => pm.expect(body).to.not.have.property('passwordHash'));"
            ]
          }
        }
      ]
    },
