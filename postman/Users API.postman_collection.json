            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Duplicate\",\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 409 Conflict', () => pm.response.to.have.status(409));",
              "pm.test('Message: Email already in use', () => {",
              "  pm.expect(pm.response.json().message).to.eql('Email already in use');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Create user - validation errors",
      "request": {
        "method": "POST",
        "header": [
          {
