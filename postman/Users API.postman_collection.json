{
  "info": {
    "name": "Users API",
    "description": "Tests for the NestJS `task-management/users` endpoints (CRUD + validation + error cases).\nRequests are designed to run in order: the create step stores `user_id`, `user_email`\nand `user_password` in collection variables for the following requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Create user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/task-management/users",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "task-management",
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"  Nguyen Van A  \",\n  \"email\": \"  {{user_email}}  \",\n  \"password\": \"{{user_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now();",
              "pm.collectionVariables.set('user_email', `User.${suffix}@Example.com`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Returns user with id', () => {",
              "  pm.expect(body.id).to.be.a('number');",
              "});",
              "pm.test('fullName is trimmed', () => {",
              "  pm.expect(body.fullName).to.eql('Nguyen Van A');",
              "});",
              "pm.test('email is trimmed and lowercased', () => {",
              "  pm.expect(body.email).to.eql(pm.collectionVariables.get('user_email').toLowerCase());",
              "});",
              "pm.test('Does not expose password / passwordHash', () => {",
              "  pm.expect(body).to.not.have.property('password');",
              "  pm.expect(body).to.not.have.property('passwordHash');",
              "});",
              "pm.test('Has timestamps', () => {",
              "  pm.expect(body).to.have.property('createdAt');",
              "  pm.expect(body).to.have.property('updatedAt');",
              "});",
              "pm.collectionVariables.set('user_id', body.id);",
              "pm.collectionVariables.set('user_email', body.email);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Create user - duplicate email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
