        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"\",\n  \"email\": \"not-an-email\",\n  \"password\": \"short\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
              "const messages = pm.response.json().message;",
              "pm.test('Reports errors for fullName, email and password', () => {",
              "  pm.expect(messages).to.be.an('array');",
              "  const text = messages.join(' | ');",
              "  pm.expect(text).to.include('fullName');",
              "  pm.expect(text).to.include('email');",
              "  pm.expect(text).to.include('password');",
              "});"
            ]
          }
        }
      ]
    },
